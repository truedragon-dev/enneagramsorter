<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Enneagram & Drama Triangle: How to Step Off</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            overflow: hidden;
            height: 100vh;
        }

        .slideshow-container {
            position: relative;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .slide {
            display: none;
            width: 90%;
            max-width: 1000px;
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            padding: 40px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
            animation: slideIn 0.5s ease-in-out;
        }

        .slide.active {
            display: block;
        }

        @keyframes slideIn {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .title-slide {
            text-align: center;
        }

        .title-slide h1 {
            font-size: 3.5rem;
            margin-bottom: 20px;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
        }

        .title-slide p {
            font-size: 1.3rem;
            opacity: 0.9;
            margin-bottom: 30px;
        }

        .type-slide h2 {
            font-size: 2.5rem;
            margin-bottom: 30px;
            text-align: center;
            color: #FFE066;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
        }

        .content-section {
            margin-bottom: 25px;
            background: rgba(255, 255, 255, 0.1);
            padding: 20px;
            border-radius: 15px;
            border-left: 4px solid #FFE066;
        }

        .content-section h3 {
            font-size: 1.4rem;
            margin-bottom: 10px;
            color: #FFE066;
        }

        .content-section p {
            font-size: 1.1rem;
            line-height: 1.6;
        }

        .navigation {
            position: fixed;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 20px;
            z-index: 100;
        }

        .nav-btn {
            padding: 12px 24px;
            background: rgba(255, 255, 255, 0.2);
            border: none;
            border-radius: 25px;
            color: white;
            cursor: pointer;
            font-size: 1rem;
            backdrop-filter: blur(10px);
            transition: all 0.3s ease;
        }

        .nav-btn:hover {
            background: rgba(255, 255, 255, 0.3);
            transform: translateY(-2px);
        }

        .nav-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .slide-counter {
            position: fixed;
            top: 30px;
            right: 30px;
            background: rgba(255, 255, 255, 0.2);
            padding: 10px 20px;
            border-radius: 20px;
            backdrop-filter: blur(10px);
            font-size: 1rem;
        }

        .triangle-visual {
            display: flex;
            justify-content: center;
            margin: 20px 0;
        }

        .triangle {
            width: 200px;
            height: 200px;
            position: relative;
            margin: 0 30px;
        }

        .triangle-shape {
            width: 0;
            height: 0;
            border-left: 100px solid transparent;
            border-right: 100px solid transparent;
            border-bottom: 173px solid rgba(255, 255, 255, 0.2);
            margin: 0 auto;
        }

        .triangle-label {
            position: absolute;
            top: -30px;
            left: 50%;
            transform: translateX(-50%);
            font-weight: bold;
            font-size: 1.2rem;
        }

        .arrow {
            font-size: 2rem;
            align-self: center;
            color: #FFE066;
        }

        .empowerment-slide {
            text-align: center;
        }

        .empowerment-slide h2 {
            color: #4ECDC4;
            margin-bottom: 30px;
        }

        .role-comparison {
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            gap: 20px;
            align-items: center;
            margin: 20px 0;
        }

        .role-box {
            background: rgba(255, 255, 255, 0.1);
            padding: 20px;
            border-radius: 15px;
            text-align: center;
        }

        .drama-role {
            border-left: 4px solid #FF6B6B;
        }

        .empowerment-role {
            border-left: 4px solid #4ECDC4;
        }

        .overview-slide .grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-top: 30px;
        }

        .type-summary {
            background: rgba(255, 255, 255, 0.1);
            padding: 20px;
            border-radius: 15px;
            text-align: center;
        }

        .type-number {
            font-size: 1.5rem;
            font-weight: bold;
            color: #FFE066;
            margin-bottom: 10px;
        }
    </style>
</head>
<body>
    <div class="slideshow-container">
        <div class="slide-counter">
            <span id="current-slide">1</span> / <span id="total-slides">12</span>
        </div>

        <!-- Title Slide -->
        <div class="slide active title-slide">
            <h1>Enneagram & Drama Triangle</h1>
            <p>How Each Type Can Step Off the Triangle into Empowerment</p>
            <div class="triangle-visual">
                <div class="triangle">
                    <div class="triangle-label">Drama Triangle</div>
                    <div class="triangle-shape"></div>
                </div>
                <div class="arrow">→</div>
                <div class="triangle">
                    <div class="triangle-label" style="color: #4ECDC4;">Empowerment Triangle</div>
                    <div class="triangle-shape" style="border-bottom-color: rgba(78, 205, 196, 0.5);"></div>
                </div>
            </div>
        </div>

        <!-- Overview Slide -->
        <div class="slide empowerment-slide">
            <h2>The Transformation Path</h2>
            <div class="role-comparison">
                <div class="role-box drama-role">
                    <h3>Drama Triangle Roles</h3>
                    <p><strong>Persecutor:</strong> Blames, criticizes, dominates</p>
                    <p><strong>Rescuer:</strong> Over-helps, enables, self-sacrifices</p>
                    <p><strong>Victim:</strong> Powerless, withdrawn, resentful</p>
                </div>
                <div class="arrow">→</div>
                <div class="role-box empowerment-role">
                    <h3>Empowerment Triangle Roles</h3>
                    <p><strong>Challenger:</strong> Names truth constructively</p>
                    <p><strong>Coach:</strong> Empowers through questions</p>
                    <p><strong>Creator:</strong> Takes ownership, generates solutions</p>
                </div>
            </div>
            <p style="margin-top: 30px; font-style: italic;">Each Enneagram type has predictable patterns of getting hooked and specific pathways to empowerment.</p>
        </div>

        <!-- Type 1 Slide -->
        <div class="slide type-slide">
            <h2>Type 1 - The Reformer</h2>
            <div class="content-section">
                <h3>Default Drama Role</h3>
                <p><strong>Persecutor</strong> - Driven by anxiety about imperfection to correct and blame others</p>
            </div>
            <div class="content-section">
                <h3>How They Get Hooked</h3>
                <p>When standards aren't met, Ones slip into criticism and fault-finding, believing that pointing out flaws will create improvement</p>
            </div>
            <div class="content-section">
                <h3>Path to Empowerment</h3>
                <p><strong>Persecutor → Challenger:</strong> Name gaps constructively and hold high standards without shaming. Focus on solutions rather than blame.</p>
            </div>
        </div>

        <!-- Type 2 Slide -->
        <div class="slide type-slide">
            <h2>Type 2 - The Helper</h2>
            <div class="content-section">
                <h3>Default Drama Roles</h3>
                <p><strong>Rescuer → Victim</strong> - Over-help to avoid rejection, then feel resentful when unappreciated</p>
            </div>
            <div class="content-section">
                <h3>How They Get Hooked</h3>
                <p>Anxiety about rejection fuels compulsive helping, leading to self-erasure and eventual resentment when others don't reciprocate</p>
            </div>
            <div class="content-section">
                <h3>Path to Empowerment</h3>
                <p><strong>Rescuer → Coach:</strong> Ask questions that empower others. Offer support without self-erasure by maintaining healthy boundaries.</p>
            </div>
        </div>

        <!-- Type 3 Slide -->
        <div class="slide type-slide">
            <h2>Type 3 - The Achiever</h2>
            <div class="content-section">
                <h3>Default Drama Roles</h3>
                <p><strong>Rescuer → Persecutor</strong> - Try to help others succeed, then dominate when feeling threatened</p>
            </div>
            <div class="content-section">
                <h3>How They Get Hooked</h3>
                <p>Anxiety about failure drives constant proving and competing, leading to dominating behaviors when success feels threatened</p>
            </div>
            <div class="content-section">
                <h3>Path to Empowerment</h3>
                <p><strong>Rescuer → Coach:</strong> Model vulnerability and invite others to succeed too. Move from proving worth to authentic contribution.</p>
            </div>
        </div>

        <!-- Type 4 Slide -->
        <div class="slide type-slide">
            <h2>Type 4 - The Individualist</h2>
            <div class="content-section">
                <h3>Default Drama Roles</h3>
                <p><strong>Victim → Persecutor</strong> - Withdraw in suffering, then lash out when feeling abandoned</p>
            </div>
            <div class="content-section">
                <h3>How They Get Hooked</h3>
                <p>Anxiety about abandonment fuels emotional withdrawal or explosive reactions when feeling misunderstood or left out</p>
            </div>
            <div class="content-section">
                <h3>Path to Empowerment</h3>
                <p><strong>Victim → Creator:</strong> Use emotional depth to generate possibilities rather than staying stuck in suffering. Transform pain into creative action.</p>
            </div>
        </div>

        <!-- Type 5 Slide -->
        <div class="slide type-slide">
            <h2>Type 5 - The Investigator</h2>
            <div class="content-section">
                <h3>Default Drama Roles</h3>
                <p><strong>Victim → Persecutor</strong> - Withdraw to conserve energy, then attack when pushed beyond limits</p>
            </div>
            <div class="content-section">
                <h3>How They Get Hooked</h3>
                <p>Anxiety about depletion leads to withholding resources, information, and energy, creating isolation and eventual conflict</p>
            </div>
            <div class="content-section">
                <h3>Path to Empowerment</h3>
                <p><strong>Victim → Creator:</strong> Share insights early and collaborate instead of hoarding knowledge. Courage equals contribution.</p>
            </div>
        </div>

        <!-- Type 6 Slide -->
        <div class="slide type-slide">
            <h2>Type 6 - The Loyalist</h2>
            <div class="content-section">
                <h3>Default Drama Roles</h3>
                <p><strong>Victim → Persecutor</strong> - Feel powerless against threats, then blame authority figures</p>
            </div>
            <div class="content-section">
                <h3>How They Get Hooked</h3>
                <p>Anxiety about insecurity drives constant doubt and questioning, leading to blaming authority when feeling unsupported</p>
            </div>
            <div class="content-section">
                <h3>Path to Empowerment</h3>
                <p><strong>Victim → Creator:</strong> Transform vigilance into foresight. Design systems that prevent problems rather than just worrying about them.</p>
            </div>
        </div>

        <!-- Type 7 Slide -->
        <div class="slide type-slide">
            <h2>Type 7 - The Enthusiast</h2>
            <div class="content-section">
                <h3>Default Drama Roles</h3>
                <p><strong>Rescuer → Victim</strong> - Over-help with positivity, then escape when reality becomes painful</p>
            </div>
            <div class="content-section">
                <h3>How They Get Hooked</h3>
                <p>Anxiety about pain fuels compulsive optimism and helping others avoid difficulty, then fleeing when problems persist</p>
            </div>
            <div class="content-section">
                <h3>Path to Empowerment</h3>
                <p><strong>Rescuer → Coach:</strong> Channel energy into helping others reframe situations realistically, not avoidantly. Stay present with difficulty.</p>
            </div>
        </div>

        <!-- Type 8 Slide -->
        <div class="slide type-slide">
            <h2>Type 8 - The Challenger</h2>
            <div class="content-section">
                <h3>Default Drama Roles</h3>
                <p><strong>Persecutor → Rescuer</strong> - Dominate to avoid vulnerability, then over-protect when others seem weak</p>
            </div>
            <div class="content-section">
                <h3>How They Get Hooked</h3>
                <p>Anxiety about vulnerability drives need to control and dominate, creating power struggles and defensive reactions</p>
            </div>
            <div class="content-section">
                <h3>Path to Empowerment</h3>
                <p><strong>Persecutor → Challenger:</strong> Use strength to protect and support the system, not overpower it. Empower others' voices and agency.</p>
            </div>
        </div>

        <!-- Type 9 Slide -->
        <div class="slide type-slide">
            <h2>Type 9 - The Peacemaker</h2>
            <div class="content-section">
                <h3>Default Drama Roles</h3>
                <p><strong>Victim → Rescuer</strong> - Withdraw to avoid conflict, then over-merge to keep peace</p>
            </div>
            <div class="content-section">
                <h3>How They Get Hooked</h3>
                <p>Anxiety about conflict drives withdrawal and self-forgetting, leading to passive-aggressive patterns and loss of self</p>
            </div>
            <div class="content-section">
                <h3>Path to Empowerment</h3>
                <p><strong>Victim → Creator:</strong> Step in with authentic presence. Stabilize the system by naming what others avoid discussing.</p>
            </div>
        </div>

        <!-- Summary Slide -->
        <div class="slide empowerment-slide">
            <h2>Key Transformation Principles</h2>
            <div class="overview-slide">
                <div class="content-section">
                    <h3>Recognize Your Pattern</h3>
                    <p>Each type has predictable ways of getting hooked into drama. Awareness is the first step to freedom.</p>
                </div>
                <div class="content-section">
                    <h3>Transform Anxiety into Action</h3>
                    <p>The core anxiety that drives drama roles can be redirected into empowered, constructive behavior.</p>
                </div>
                <div class="content-section">
                    <h3>Practice New Responses</h3>
                    <p>Stepping off the triangle requires conscious practice of new behaviors until they become natural.</p>
                </div>
            </div>
        </div>

        <!-- Final Slide -->
        <div class="slide title-slide">
            <h1>Step Into Empowerment</h1>
            <p>Transform your Enneagram patterns from drama to empowerment</p>
            <div style="margin-top: 40px; font-size: 1.2rem;">
                <p><strong>Remember:</strong> The goal isn't to eliminate your type's energy—it's to channel it constructively.</p>
            </div>
        </div>
    </div>

    <div class="navigation">
        <button class="nav-btn" id="prevBtn" onclick="changeSlide(-1)">Previous</button>
        <button class="nav-btn" id="nextBtn" onclick="changeSlide(1)">Next</button>
    </div>

    <script>
        let currentSlideIndex = 0;
        const slides = document.querySelectorAll('.slide');
        const totalSlides = slides.length;
        
        document.getElementById('total-slides').textContent = totalSlides;

        function showSlide(index) {
            slides.forEach(slide => slide.classList.remove('active'));
            slides[index].classList.add('active');
            
            document.getElementById('current-slide').textContent = index + 1;
            
            // Update navigation buttons
            document.getElementById('prevBtn').disabled = index === 0;
            document.getElementById('nextBtn').disabled = index === totalSlides - 1;
        }

        function changeSlide(direction) {
            currentSlideIndex += direction;
            if (currentSlideIndex < 0) currentSlideIndex = 0;
            if (currentSlideIndex >= totalSlides) currentSlideIndex = totalSlides - 1;
            showSlide(currentSlideIndex);
        }

        // Keyboard navigation
        document.addEventListener('keydown', function(event) {
            if (event.key === 'ArrowRight' || event.key === ' ') {
                event.preventDefault();
                if (currentSlideIndex < totalSlides - 1) changeSlide(1);
            } else if (event.key === 'ArrowLeft') {
                event.preventDefault();
                if (currentSlideIndex > 0) changeSlide(-1);
            }
        });

        // Initialize
        showSlide(0);
    </script>
</body>
</html>
